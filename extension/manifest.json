{
    "manifest_version": 3,
    "name": "Application Autofill AI",
    "version": "0.1.0",
    "description": "Scans application forms and drafts answers using AI.",
    "permissions": ["activeTab", "storage", "scripting"],
    "host_permissions": ["http://127.0.0.1:5000/*", "<all_urls>"],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }